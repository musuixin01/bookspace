<?xml version="1.0" encoding="utf-8"?><Database Name="Books" Class="BooksDataContext" xmlns="http://schemas.microsoft.com/linqtosql/dbml/2007">
  <Connection Mode="WebSettings" ConnectionString="Data Source=(local);Initial Catalog=Books;Integrated Security=True" SettingsObjectName="System.Configuration.ConfigurationManager.ConnectionStrings" SettingsPropertyName="BooksConnectionString" Provider="System.Data.SqlClient" />
  <Table Name="dbo.BookCategory" Member="BookCategory">
    <Type Name="BookCategory">
      <Column Name="CategoryId" Type="System.Int32" DbType="Int NOT NULL IDENTITY" IsPrimaryKey="true" IsDbGenerated="true" CanBeNull="false" />
      <Column Name="CategoryName" Type="System.String" DbType="NVarChar(20) NOT NULL" CanBeNull="false" />
      <Association Name="BookCategory_BookInfo" Member="BookInfo" ThisKey="CategoryId" OtherKey="CategoryId" Type="BookInfo" />
    </Type>
  </Table>
  <Table Name="dbo.BookInfo" Member="BookInfo">
    <Type Name="BookInfo">
      <Column Name="BookNum" Type="System.Int32" DbType="Int NOT NULL IDENTITY" IsPrimaryKey="true" IsDbGenerated="true" CanBeNull="false" />
      <Column Name="BookName" Type="System.String" DbType="NVarChar(50) NOT NULL" CanBeNull="false" />
      <Column Name="BookPrice" Type="System.Decimal" DbType="Decimal(6,2)" CanBeNull="true" />
      <Column Name="Author" Type="System.String" DbType="NVarChar(30)" CanBeNull="true" />
      <Column Name="Publisher" Type="System.String" DbType="NVarChar(100)" CanBeNull="true" />
      <Column Name="CategoryId" Type="System.Int32" DbType="Int NOT NULL" CanBeNull="false" />
      <Association Name="BookCategory_BookInfo" Member="BookCategory" ThisKey="CategoryId" OtherKey="CategoryId" Type="BookCategory" IsForeignKey="true" />
    </Type>
  </Table>
</Database>